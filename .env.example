# Copy to .env and fill in. Do not commit .env.

# Set to 1 to use local PostgreSQL instead of Docker (run ./scripts/setup-local-postgres.sh first)
# USE_LOCAL_POSTGRES=1

# Database (used by API; matches infra/docker-compose.yml)
DATABASE_URL="postgresql://lifedesign:lifedesign_local@localhost:5432/lifedesign"

# API
API_PORT=3000
OPENAI_API_KEY=
OPENAI_API_KEY=

# Mobile: point to your machine's IP or use localhost for simulator
# EXPO_PUBLIC_API_URL=http://localhost:3000
